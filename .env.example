# Optional overrides — keap-mcp has no required env vars.
# Authentication is per-request via the X-Keap-Access-Token request header
# (a Keap Personal Access Token or Service Account Key, generated in the
# Keap app under Settings -> API Settings).
# This server forwards it to Keap as `Authorization: Bearer <token>`.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
