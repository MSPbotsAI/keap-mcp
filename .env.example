# ─── Keap API Credentials ────────────────────────────────────────────────────
KEAP_ACCESS_TOKEN=your_personal_access_token_or_service_account_key

KEAP_ACCESS_TOKEN_HEADER=X-Keap-Access-Token

# ─── MCP Transport ───────────────────────────────────────────────────────────
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# ─── Auth Mode ───────────────────────────────────────────────────────────────
AUTH_MODE=gateway
